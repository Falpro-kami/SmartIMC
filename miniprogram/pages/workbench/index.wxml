<block wx:if="{{membershipAllowed}}">
<view class="tab-page imc-theme">
<user-header title="工作台" />
<view class="workbench-page">
  <view wx:for="{{applicationGroups}}" wx:for-item="group" wx:key="id" class="app-section">
    <text class="section-title">{{group.title}}</text>
    <view class="tools-grid">
      <button
        wx:for="{{group.tools}}"
        wx:for-item="tool"
        wx:key="id"
        class="tool-entry"
        hover-class="tool-entry--pressed"
        aria-label="{{tool.name}}"
        data-id="{{tool.id}}"
        bindtap="openTool"
      >
        <image class="tool-icon" src="{{tool.icon}}" mode="aspectFit" />
        <text class="tool-label">{{tool.name}}</text>
      </button>
    </view>
  </view>
</view>
</view>
</block>
<membership-gate wx:else />
