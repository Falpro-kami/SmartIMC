<view class="tab-page imc-theme">
<user-header title="工作台" />
<view class="workbench-page">
  <view class="app-section">
    <text class="section-title">常用应用</text>
    <view class="tools-grid">
      <button wx:for="{{commonTools}}" wx:key="id" class="tool-entry" hover-class="tool-entry--pressed" aria-label="{{item.name}}" data-id="{{item.id}}" bindtap="openTool"><image class="tool-icon" src="{{item.icon}}" mode="aspectFit" /><text class="tool-label">{{item.label}}</text></button>
    </view>
  </view>
  <view class="app-section all-apps">
  <text class="section-title">全部应用</text>
  <view class="tools-grid">
    <button
      wx:for="{{tools}}"
      wx:key="id"
      class="tool-entry"
      hover-class="tool-entry--pressed"
      aria-label="{{item.name}}"
      data-url="{{item.url}}"
      data-id="{{item.id}}"
      bindtap="openTool"
    >
      <image class="tool-icon" src="{{item.icon}}" mode="aspectFit"></image>
      <text class="tool-label">{{item.label}}</text>
    </button>
  </view>
  </view>
</view>
</view>
