.workbench-page { box-sizing: border-box; padding: 16px 16px 26px; }
.app-section { padding: 16px 10px 22px; border: 1px solid #e9edf5; border-radius: 14px; background: #fff; }
.app-section + .app-section { margin-top: 14px; }
.section-title { display: block; padding: 0 6px; color: #101b2b; font-size: 18px; font-weight: 600; line-height: 27px; }
.tools-grid { display: flex; flex-wrap: wrap; align-items: flex-start; width: 100%; row-gap: 22px; margin-top: 20px; }
.tool-entry { display: flex; box-sizing: border-box; flex: 0 0 25%; flex-direction: column; align-items: center; justify-content: flex-start; width: 25%; min-width: 0; min-height: 81px; margin: 0; padding: 0; border: 0; border-radius: 10px; background: transparent; color: #101b2b; font-weight: 400; line-height: 1.5; text-align: center; }
.tool-entry::after { border: 0; }
.tool-entry--pressed { background: #f4f6fb; }
.tool-icon { display: block; width: 52px; height: 52px; }
.tool-label { display: block; margin-top: 9px; font-size: 14px; line-height: 20px; white-space: nowrap; word-break: keep-all; }
@media (max-width: 350px) { .workbench-page { padding-left: 12px; padding-right: 12px; } .app-section { padding-left: 8px; padding-right: 8px; } .tool-label { font-size: 13px; } }
