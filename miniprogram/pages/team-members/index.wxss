@import "../../styles/list.wxss";
.member-row { display: flex; align-items: center; gap: 14px; padding: 16px; margin: 0 0 12px; border: 1px solid #dde3ec; border-radius: 10px; background: white; }
.avatar { width: 48px; height: 48px; background: #f5f6f8; color: #101b2b; border-radius: 50%; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 600; }
.avatar image { width: 100%; height: 100%; }
.invite-row { box-sizing: border-box; width: 100%; text-align: left; line-height: 1.5; color: #005bac; font-weight: 500; }
.invite-avatar { box-sizing: border-box; background: #edf3f8; color: #005bac; }
.invite-plus { position: relative; width: 20px; height: 20px; }
.invite-plus::before, .invite-plus::after { content: ''; position: absolute; background: currentColor; border-radius: 1px; }
.invite-plus::before { width: 20px; height: 2px; top: 9px; left: 0; }
.invite-plus::after { width: 2px; height: 20px; top: 0; left: 9px; }
.member-info { flex: 1; min-width: 0; }
.name { display: block; font-size: 16px; font-weight: 600; overflow-wrap: anywhere; }
.roles { display: block; font-size: 14px; color: #526173; margin-top: 6px; line-height: 1.5; overflow-wrap: anywhere; }
