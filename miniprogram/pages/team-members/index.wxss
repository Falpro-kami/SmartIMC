@import "../../styles/list.wxss";
.member-row { display: flex; align-items: center; gap: 14px; padding: 16px; margin: 0 0 12px; border: 1px solid #e5eaf2; border-radius: 10px; background: white; }
.avatar { width: 48px; height: 48px; background: #f4f6f9; color: #101b2b; border-radius: 50%; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 600; }
.avatar image { width: 100%; height: 100%; }
.invite-row { box-sizing: border-box; width: 100%; text-align: left; line-height: 1.5; color: #2860cf; font-weight: 500; }
.invite-avatar { box-sizing: border-box; background: #edf2ff; color: #2860cf; }
.invite-plus { position: relative; width: 20px; height: 20px; }
.invite-plus::before, .invite-plus::after { content: ''; position: absolute; background: currentColor; border-radius: 1px; }
.invite-plus::before { width: 20px; height: 2px; top: 9px; left: 0; }
.invite-plus::after { width: 2px; height: 20px; top: 0; left: 9px; }
.member-info { flex: 1; min-width: 0; }
.name { display: block; font-size: 16px; font-weight: 600; overflow-wrap: anywhere; }
.roles { display: block; font-size: 14px; color: #526173; margin-top: 6px; line-height: 1.5; overflow-wrap: anywhere; }

.directory-card { border: 1px solid #e9edf5; background: #fff; border-radius: 14px; padding: 0 16px; }
.member-row { margin: 0; padding: 14px 0; min-height: 77px; border: 0; border-bottom: 1px solid #edf0f4; border-radius: 0; gap: 13px; }
.member-row:last-child { border-bottom: 0; }
.avatar { width: 40px; height: 40px; border-radius: 12px; background: #edf2fa; color: #5377ad; font-size: 17px; font-weight: 400; }
.member-row:nth-child(2) .avatar { background: #eaf4f0; color: #337f76; }
.member-row:nth-child(3) .avatar { background: #f3edf8; color: #8963a7; }
.roles { font-size: 12px; line-height: 19px; margin-top: 3px; color: #6b788a; }
.invite-row { font-weight: 500; min-height: 77px; }
.invite-avatar { background: #edf2ff; color: #2860cf; }
