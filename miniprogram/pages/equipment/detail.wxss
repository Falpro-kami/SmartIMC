.detail-page { padding: 20px 16px calc(24px + env(safe-area-inset-bottom)); color: #101b2b; }
.detail-hero, .detail-section { background: #fff; border: 1px solid #e5eaf2; border-radius: 10px; padding: 16px; margin-bottom: 16px; }
.detail-illustration { height: 180px; border-radius: 8px; background: #f4f6f9; display: flex; flex-direction: column; justify-content: center; align-items: center; margin-bottom: 20px; overflow: hidden; }
.detail-illustration image { width: 56px; height: 56px; opacity: .55; }
.detail-illustration .detail-photo { width: 100%; height: 100%; opacity: 1; }
.detail-illustration text { font-size: 14px; color: #6b788a; margin-top: 8px; }
.detail-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.detail-name { min-width: 0; font-size: 20px; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.detail-status { flex-shrink: 0; margin-top: 3px; padding: 3px 6px; border-radius: 4px; font-size: 13px; }
.status-idle, .status-unknown { background: #f4f6f9; color: #526173; }
.status-using { background: #eaf6f0; color: #087f58; }
.status-lent { background: #f2ebf8; color: #715094; }
.detail-subtitle { display: block; color: #526173; font-size: 14px; margin-top: 10px; }
.section-title { display: block; font-size: 20px; font-weight: 600; margin-bottom: 4px; }
.detail-row { padding: 16px 0; border-bottom: 1px solid #e5eaf2; display: flex; gap: 12px; align-items: flex-start; font-size: 16px; line-height: 1.6; }
.detail-row:last-child { border-bottom: none; padding-bottom: 0; }
.detail-label { width: 80px; flex-shrink: 0; color: #526173; }
.detail-value-area { flex: 1; min-width: 0; display: flex; justify-content: flex-end; align-items: flex-start; flex-wrap: wrap; gap: 4px 8px; }
.detail-value { min-width: 0; text-align: right; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.copy-button { margin: -8px -4px -8px 0; padding: 8px 4px; min-height: 44px; border-radius: 4px; background: transparent; color: #2860cf; font-size: 14px; line-height: 28px; flex-shrink: 0; }
.notes-text { display: block; white-space: pre-wrap; font-size: 16px; line-height: 1.7; padding: 12px 0 0; overflow-wrap: anywhere; }
.notes-empty { color: #6b788a; }
.detail-state { padding: 48px 16px; text-align: center; color: #526173; font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }
.detail-retry { min-height: 44px; margin-top: 16px; background: #edf2ff; color: #2860cf; border-radius: 8px; font-size: 14px; }
@media (max-width: 350px) { .detail-page { padding-left: 12px; padding-right: 12px; } }

.detail-page { min-height: 100vh; box-sizing: border-box; padding-top: 17px; background: #f3f5f9; }
.detail-hero { padding: 0; border: 0; background: transparent; margin-bottom: 18px; }
.detail-illustration { height: 145px; background: #fff; border: 1px solid #e5eaf2; border-radius: 14px; margin-bottom: 17px; }
.detail-name { font-size: 23px; line-height: 34px; }
.detail-subtitle { font-size: 13px; line-height: 22px; margin-top: 7px; color: #6b788a; }
.detail-section { border-color: #e9edf5; border-radius: 14px; padding: 18px; margin-bottom: 14px; }
.section-title { font-size: 19px; line-height: 29px; margin-bottom: 15px; }
.detail-row { padding: 13px 0; min-height: 53px; box-sizing: border-box; border-color: #edf0f4; font-size: 15px; }
.detail-label { font-size: 13px; color: #6b788a; }
.copy-button { font-size: 12px; }
.detail-status { border-radius: 6px; font-size: 11px; line-height: 24px; padding: 0 7px; }
