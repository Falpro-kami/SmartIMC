.equipment-page { color: #101b2b; padding-bottom: calc(20px + env(safe-area-inset-bottom)); }
button::after { border: 0; }
.controls { position: sticky; top: 0; z-index: 5; background: #fff; padding: 16px 16px; border-bottom: 1px solid #e5eaf2; }
.search-row { display: flex; align-items: center; gap: 10px; }
.search-box { flex: 1; min-width: 0; height: 44px; padding: 0 12px; border-radius: 8px; background: #f4f6f9; display: flex; align-items: center; gap: 10px; }
.search-icon { width: 16px; height: 16px; border: 1.5px solid #526173; border-radius: 50%; box-sizing: border-box; position: relative; flex-shrink: 0; }
.search-icon::after { content: ''; position: absolute; width: 7px; height: 1.5px; background: #526173; right: -5px; bottom: -3px; transform: rotate(45deg); border-radius: 1px; }
.search-input { flex: 1; min-width: 0; height: 40px; font-size: 15px; color: #101b2b; }
.search-placeholder { color: #6b788a; }
.clear-search { background: transparent; color: #526173; width: 28px; line-height: 44px; padding: 0; margin: 0 -4px 0 0; font-size: 24px; }
.filter-button, .browse-button { flex-shrink: 0; min-height: 44px; padding: 0; margin: 0; background: transparent; color: #526173; line-height: 1.3; font-size: 13px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
.filter-button { width: 44px; }
.filter-button > text { white-space: nowrap; }
.browse-button { width: 56px; }
.browse-label { display: block; flex-shrink: 0; white-space: nowrap; word-break: keep-all; }
.filter-active { color: #2860cf; }
.filter-icon { width: 22px; height: 20px; display: flex; flex-direction: column; align-items: center; }
.filter-icon::before, .filter-icon::after, .filter-icon view { content: ''; display: block; height: 1.5px; background: currentColor; border-radius: 2px; margin-bottom: 5px; }
.filter-icon::before { width: 22px; }
.filter-icon view { width: 14px; }
.filter-icon::after { width: 7px; }
.browse-icon { width: 20px; height: 20px; box-sizing: border-box; }
.browse-icon-card { display: flex; flex-direction: column; gap: 4px; }
.browse-icon-card view { height: 8px; border: 1.5px solid currentColor; border-radius: 2px; box-sizing: border-box; }
.browse-icon view:last-child { display: none; }
.browse-icon-table { position: relative; border: 1.5px solid currentColor; border-radius: 2px; }
.browse-icon-table::before, .browse-icon-table::after { content: ''; position: absolute; width: 1px; top: 0; bottom: 0; background: currentColor; }
.browse-icon-table::before { left: 5px; }
.browse-icon-table::after { right: 5px; }
.browse-icon-table view { position: absolute; width: 100%; height: 1px; background: currentColor; }
.browse-icon-table view:first-child { top: 5px; }
.browse-icon-table view:nth-child(2) { bottom: 5px; }
.active-filters { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 12px 16px 0; }
.active-chip { color: #2860cf; background: #edf2ff; border-radius: 4px; padding: 4px 8px; font-size: 13px; }
.reset-link { background: transparent; color: #2860cf; font-size: 13px; padding: 8px 0; margin: 0 0 0 auto; min-height: 44px; line-height: 28px; }
.card-list { padding: 16px 16px 0; }
.equipment-card { width: 100%; box-sizing: border-box; padding: 16px 16px 0; margin: 0 0 12px; border: 1px solid #e5eaf2; border-radius: 10px; background: #fff; color: inherit; text-align: left; line-height: 1.5; }
.row-pressed { background: #f8f9fb; }
.card-main { display: flex; align-items: flex-start; gap: 10px; min-height: 82px; padding-bottom: 16px; }
.card-identity { flex: 1; min-width: 0; }
.device-name { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; color: #101b2b; font-size: 16px; font-weight: 600; line-height: 1.5; }
.field-label { display: block; color: #526173; font-size: 13px; line-height: 1.5; }
.number-label { margin-top: 8px; }
.asset-number { display: block; color: #101b2b; font-size: 15px; font-variant-numeric: tabular-nums; margin-top: 2px; }
.device-photo { flex: 0 0 76px; width: 76px; height: 70px; overflow: hidden; border: 1px solid #e5eaf2; border-radius: 6px; background: #fafbfc; box-sizing: border-box; }
.device-photo image { width: 100%; height: 100%; }
.photo-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: 6px; color: #6b788a; font-size: 13px; }
.photo-symbol { width: 24px; height: 20px; position: relative; border: 1.5px solid #8b96a4; border-radius: 3px; overflow: hidden; }
.photo-symbol::before { content: ''; position: absolute; width: 4px; height: 4px; border-radius: 50%; background: #8b96a4; left: 4px; top: 4px; }
.photo-symbol view { position: absolute; width: 16px; height: 16px; transform: rotate(45deg); left: 8px; top: 9px; border-left: 1.5px solid #8b96a4; border-top: 1.5px solid #8b96a4; }
.card-status { flex: 0 0 auto; display: flex; justify-content: flex-end; align-items: center; gap: 6px; padding-top: 2px; }
.status-tag { display: block; white-space: nowrap; padding: 3px 5px; border-radius: 4px; font-size: 12px; line-height: 1.4; }
.status-idle, .status-unknown { color: #526173; background: #f4f6f9; }
.status-using { color: #087f58; background: #eaf6f0; }
.status-lent { color: #715094; background: #f2ebf8; }
.chevron { color: #6b788a; font-size: 24px; line-height: 1; font-weight: 400; }
.card-fields { display: flex; border-top: 1px solid #e5eaf2; padding: 12px 0 16px; }
.card-field { flex: 1; min-width: 0; padding: 0 10px; border-left: 1px solid #e5eaf2; }
.card-field:first-child { padding-left: 0; border-left: 0; }
.card-field:last-child { padding-right: 0; }
.field-value { display: block; color: #101b2b; font-size: 15px; line-height: 1.5; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.equipment-table { margin: 0 16px; }
.table-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) 76px 52px 68px 10px; column-gap: 8px; align-items: center; }
.table-header { min-height: 48px; font-size: 13px; font-weight: 600; color: #101b2b; border-bottom: 1px solid #e5eaf2; background: #f4f6f9; }
.table-header text { white-space: nowrap; }
.table-row { box-sizing: border-box; width: 100%; min-height: 68px; padding: 16px 0; margin: 0; border-radius: 0; border-bottom: 1px solid #e5eaf2; text-align: left; line-height: 1.6; background: #fff; font-size: 15px; color: #101b2b; }
.table-name { min-width: 0; overflow-wrap: anywhere; }
.table-number, .table-location { white-space: nowrap; font-variant-numeric: tabular-nums; }
.table-status { display: flex; align-items: center; gap: 5px; font-size: 13px; white-space: nowrap; color: #526173; }
.table-status-using { color: #087f58; }
.status-dot { flex-shrink: 0; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
.table-status-lent { color: #715094; }
.table-row .chevron { font-size: 22px; text-align: right; }
.state-panel { display: flex; flex-direction: column; align-items: center; padding: 48px 16px; }
.state-title { font-size: 15px; color: #526173; text-align: center; }
.empty-reset { background: #edf2ff; color: #2860cf; border-radius: 8px; font-size: 14px; padding: 0 16px; line-height: 44px; min-height: 44px; margin-top: 16px; }
.loading-ring { width: 24px; height: 24px; border: 2px solid #e5eaf2; border-top-color: #2860cf; border-radius: 50%; margin-bottom: 16px; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.error-panel { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 12px; margin: 16px 16px; border: 1px solid #ecd4d0; border-radius: 8px; color: #ad4037; font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }
.error-panel text { flex: 1; min-width: 0; }
.error-panel button { margin: 0; padding: 8px 0; flex-shrink: 0; color: #ad4037; background: transparent; font-size: 14px; line-height: 28px; min-height: 44px; }
.refresh-note, .list-end { display: block; text-align: center; color: #6b788a; font-size: 13px; padding: 16px 0; }
.load-more { width: 100%; background: transparent; color: #2860cf; font-size: 14px; padding: 8px 0; min-height: 44px; line-height: 28px; }
.filter-overlay { position: fixed; inset: 0; z-index: 50; background: rgba(24,33,47,.3); display: flex; align-items: flex-end; }
.filter-sheet { width: 100%; box-sizing: border-box; background: #fff; border-radius: 16px 16px 0 0; padding: 16px 16px calc(16px + env(safe-area-inset-bottom)); }
.sheet-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 18px; font-weight: 600; padding-bottom: 12px; }
.sheet-close { margin: 0; padding: 0; width: 44px; height: 44px; color: #526173; font-size: 28px; background: transparent; line-height: 44px; }
.filter-scroll { height: 46vh; }
.filter-label { display: block; color: #526173; font-size: 14px; font-weight: 600; padding: 12px 0; }
.filter-options { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
.option { margin: 0; padding: 10px 14px; min-height: 44px; border: 1px solid #e5eaf2; border-radius: 8px; background: white; color: #526173; font-size: 14px; line-height: 22px; }
.option-selected { border-color: #2860cf; background: #edf2ff; color: #2860cf; font-weight: 500; }
.sheet-actions { display: flex; gap: 12px; padding-top: 16px; margin-top: 8px; border-top: 1px solid #e5eaf2; }
.reset-button, .apply-button { margin: 0; border-radius: 8px; font-size: 16px; min-height: 48px; line-height: 48px; }
.reset-button { width: 30%; background: #f4f6f9; color: #526173; }
.apply-button { flex: 1; background: #2860cf; color: #fff; }
@media (max-width: 350px) {
  .table-grid { grid-template-columns: minmax(0, 1.4fr) 70px 50px 60px 8px; column-gap: 6px; }
  .table-row { font-size: 13px; }
  .table-header, .table-status { font-size: 12px; }
  .table-status { gap: 4px; }
  .status-dot { width: 4px; height: 4px; }
  .search-row { gap: 6px; }
  .search-box { padding: 0 8px; gap: 8px; }
  .equipment-card { padding: 12px 12px 0; }
  .card-main { gap: 8px; flex-wrap: wrap; }
  .card-identity { flex-basis: calc(100% - 86px); }
  .card-status { width: 100%; justify-content: flex-start; }
}
@media (max-width: 350px) { .controls, .active-filters, .card-list, .state-panel, .filter-sheet { padding-left: 12px; padding-right: 12px; } .equipment-table, .error-panel { margin-left: 12px; margin-right: 12px; } }

.equipment-page { min-height: 100vh; background: #f3f5f9; }
.controls { padding-top: 17px; padding-bottom: 17px; background: #f3f5f9; border-bottom: 0; }
.search-box { height: 45px; border-radius: 9px; background: #e9edf4; }
.search-input { font-size: 14px; }
.search-placeholder { color: #8794a6; }
.browse-button, .filter-button { font-size: 11px; gap: 1px; line-height: 18px; }
.browse-button { width: 46px; }
.filter-button { width: 40px; }
.card-list { padding-top: 0; }
.equipment-card { border-color: #e9edf5; border-radius: 14px; padding: 18px 18px 0; margin-bottom: 14px; }
.device-name { font-size: 18px; line-height: 27px; }
.card-main { padding-bottom: 15px; gap: 12px; }
.device-photo { width: 77px; height: 76px; flex-basis: 77px; border-color: #edf0f4; background: #fafbfd; }
.card-fields { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; padding: 12px 0 16px; border-color: #edf0f4; }
.card-field { border: 0; padding: 0; }
.field-label { font-size: 12px; line-height: 20px; color: #6b788a; }
.field-value { font-size: 14px; margin-top: 2px; }
.equipment-table { margin: 0 9px; background: #fff; border: 1px solid #e5eaf2; border-radius: 12px; overflow: hidden; }
.table-grid { grid-template-columns: minmax(0,1.55fr) 1.2fr .7fr 1fr 10px; column-gap: 6px; padding-left: 14px; padding-right: 14px; }
.table-header { min-height: 48px; font-size: 12px; font-weight: 500; background: #edf0f5; }
.table-row { min-height: 78px; padding-top: 21px; padding-bottom: 21px; font-size: 14px; border-color: #e9edf2; }
.table-status { font-size: 12px; }
.filter-sheet { border-radius: 20px 20px 0 0; padding-left: 20px; padding-right: 20px; }
.option { background: #f7f9fc; border-color: #f7f9fc; border-radius: 8px; }
.option-selected { border-color: #b9cced; background: #edf2ff; color: #2860cf; }
.reset-button, .apply-button { border-radius: 10px; min-height: 46px; line-height: 46px; }
@media (max-width: 350px) { .table-grid { grid-template-columns: minmax(0,1.4fr) 70px 48px 62px 8px; column-gap: 5px; padding-left: 9px; padding-right: 9px; } .table-row { font-size: 13px; } .equipment-table { margin-left: 6px; margin-right: 6px; } }

.card-fields .card-status { justify-content: flex-start; padding-top: 0; width: auto; }
.card-fields .card-status .chevron { display: none; }
