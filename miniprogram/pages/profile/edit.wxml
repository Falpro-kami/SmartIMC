<block wx:if="{{membershipAllowed}}">
<view class="profile-editor imc-theme">
  <view class="editor-card">
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{loading || saving}}" aria-label="选择微信头像"><view class="editor-avatar"><image wx:if="{{draftAvatar || avatar}}" src="{{draftAvatar || avatar}}" mode="aspectFill" binderror="avatarFailed" /><text wx:else>{{initials}}</text></view><text class="avatar-action">选择微信头像</text></button>
    <view class="field"><text class="field-label">姓名</text><input value="{{name}}" placeholder="请输入姓名" placeholder-class="field-placeholder" maxlength="32" disabled="{{loading || saving}}" bindinput="onNameInput" /></view>
    <view class="field"><text class="field-label">团队</text><text>{{teamName}}</text></view>
  </view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <button class="save-button" bindtap="saveProfile" loading="{{loading || saving}}" disabled="{{loading || saving}}">保存</button>
</view>
</block>
<membership-gate wx:else />
