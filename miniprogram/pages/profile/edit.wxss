.profile-editor { padding: 20px 16px calc(24px + env(safe-area-inset-bottom)); }
.editor-card { border: 1px solid #dde3ec; border-radius: 10px; padding: 20px 16px 0; background: white; }
.avatar-picker { padding: 0; margin: 0 auto 24px; background: transparent; display: flex; flex-direction: column; align-items: center; width: 160px; line-height: 1.5; }
.editor-avatar { width: 72px; height: 72px; border-radius: 50%; overflow: hidden; background: #f5f6f8; color: #101b2b; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 600; }
.editor-avatar image { width: 100%; height: 100%; }
.avatar-action { font-size: 14px; color: #005bac; margin-top: 12px; min-height: 32px; }
.field { display: flex; align-items: center; gap: 20px; padding: 16px 0; border-top: 1px solid #dde3ec; font-size: 16px; line-height: 1.6; min-height: 56px; box-sizing: border-box; }
.field-label { width: 52px; flex-shrink: 0; color: #526173; }
.field input { flex: 1; min-width: 0; font-size: 16px; height: 32px; color: #101b2b; }
.field-placeholder { color: #637083; }
.error { display: block; margin: 16px 0; color: #ad4037; font-size: 14px; line-height: 1.6; }
.save-button { width: 100%; background: #005bac; color: white; margin: 24px 0 0; border-radius: 8px; font-size: 16px; min-height: 48px; line-height: 48px; }
@media (max-width: 350px) { .profile-editor { padding-left: 12px; padding-right: 12px; } }
