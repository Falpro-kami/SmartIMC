@import "../../styles/list.wxss";

/* 紧凑速览：连续白底列表；标题、摘要和时间常显，正文与操作按需展开。 */
page { background: #ffffff; }
.messages-page { min-height: 100vh; padding: 12px 20px calc(28px + env(safe-area-inset-bottom)); background: #ffffff; }
.messages-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
.message-filters { display: flex; align-items: center; gap: 3px; padding: 3px; border-radius: 8px; background: #f1f4f8; }
.filter-button { min-width: 58px; min-height: 44px; margin: 0; padding: 0 12px; border-radius: 6px; background: transparent; color: #6b788a; font-size: 13px; line-height: 44px; white-space: nowrap; }
.filter-active { color: #172332; font-weight: 600; background: #ffffff; box-shadow: 0 1px 4px rgba(38, 58, 92, .07); }
.filter-count { margin-left: 4px; color: #788497; font-size: 11px; font-weight: 400; }
.filter-active .filter-count { color: #2860cf; }
.mark-read { min-height: 44px; margin: 0; padding: 0; background: transparent; color: #2860cf; font-size: 12px; line-height: 44px; text-align: right; white-space: nowrap; }
.mark-all { min-width: 52px; flex-shrink: 0; }
.mark-read[disabled] { color: #8490a0; opacity: 1; }
.message-row { margin: 0; border-bottom: 1px solid #e9edf2; }
.message-summary { width: 100%; display: flex; align-items: center; gap: 10px; margin: 0; padding: 17px 0; border-radius: 0; background: transparent; text-align: left; line-height: 1.55; }
.message-summary-main { flex: 1; min-width: 0; }
.message-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.message-title-group { display: flex; align-items: center; gap: 8px; min-width: 0; }
.message-title { min-width: 0; font-size: 15px; line-height: 23px; font-weight: 600; color: #172332; overflow-wrap: anywhere; }
.message-read .message-title { font-weight: 400; }
.unread-dot { width: 5px; height: 5px; border-radius: 50%; background: #e34c56; flex-shrink: 0; }
.message-time { flex-shrink: 0; color: #788497; font-size: 11px; line-height: 23px; }
.message-preview { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; max-height: 44px; overflow: hidden; margin-top: 5px; color: #526279; font-size: 13px; line-height: 22px; overflow-wrap: anywhere; }
.message-chevron { width: 7px; height: 7px; margin: -4px 4px 0 2px; border-right: 1.5px solid #8b98aa; border-bottom: 1.5px solid #8b98aa; transform: rotate(45deg); flex-shrink: 0; }
.message-chevron-up { transform: rotate(225deg); margin-top: 3px; }
.message-details { padding: 10px 0 8px; border-top: 1px dashed #e2e7ee; }
.message-body { display: block; font-size: 13px; line-height: 1.8; color: #526279; white-space: pre-wrap; overflow-wrap: anywhere; }
.message-footer { display: flex; align-items: center; justify-content: space-between; gap: 4px 10px; flex-wrap: wrap; margin-top: 3px; }
.message-date, .message-status { color: #788497; font-size: 11px; line-height: 24px; }
.message-actions { display: flex; align-items: center; gap: 10px; margin-left: auto; }
.related-message { min-height: 44px; margin: 0; padding: 0; background: transparent; color: #2860cf; font-size: 12px; line-height: 44px; text-align: left; }
.target-loading { display: block; padding: 8px 0; font-size: 11px; line-height: 20px; color: #788497; }
.more { margin-top: 14px; padding: 8px 0; color: #6b788a; background: transparent; border-radius: 0; font-size: 12px; }
.messages-end { display: block; margin-top: 24px; text-align: center; font-size: 11px; line-height: 20px; color: #8590a0; }
@media (max-width: 350px) {
  .messages-page { padding-left: 16px; padding-right: 16px; }
  .messages-toolbar { gap: 7px; }
  .filter-button { min-width: 50px; padding-left: 9px; padding-right: 9px; }
  .message-heading { gap: 7px; }
}
