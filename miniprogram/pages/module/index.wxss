.module-page { padding: 24px 16px calc(24px + env(safe-area-inset-bottom)); }
.module-card { padding: 40px 20px; border: 1px solid #e5eaf2; border-radius: 10px; display: flex; flex-direction: column; align-items: center; text-align: center; background: white; }
.module-card image { width: 48px; height: 48px; margin-bottom: 20px; }
.module-title { color: #101b2b; font-size: 20px; font-weight: 600; }
.module-status { color: #526173; font-size: 14px; margin-top: 12px; }
.settings-page { padding-top: 20px; padding-bottom: calc(28px + env(safe-area-inset-bottom)); color: #101b2b; }
.settings-card { padding: 0 16px; border: 1px solid #e5eaf2; border-radius: 9px; background: #fff; }
.settings-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; min-height: 60px; margin: 0; padding: 16px 0; border-bottom: 1px solid #e5eaf2; border-radius: 0; color: #101b2b; background: #fff; text-align: left; font-size: 16px; line-height: 26px; }
.settings-row:last-child { border-bottom: 0; }
.arrow { color: #101b2b; font-size: 24px; font-weight: 400; line-height: 1; }
.row-pressed { background: #f4f6f9; }
.admin-card { margin-bottom: 14px; padding: 18px 16px; border: 1px solid #e5eaf2; border-radius: 9px; background: #fff; color: #101b2b; }
.admin-title { display: block; margin-bottom: 16px; color: #101b2b; font-size: 20px; font-weight: 600; line-height: 28px; }
.admin-field { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 16px 0; border-bottom: 1px solid #e5eaf2; font-size: 16px; line-height: 26px; }
.admin-field:last-child { border-bottom: 0; padding-bottom: 0; }
.admin-field > text:first-child { color: #526173; flex-shrink: 0; }
.admin-field > text:last-child { min-width: 0; text-align: right; overflow-wrap: anywhere; }
.admin-warning { color: #ad4037; }
.backup-label { display: block; margin-bottom: 10px; color: #526173; font-size: 16px; line-height: 24px; }
.password-confirm-label { margin-top: 16px; }
.backup-password { box-sizing: border-box; width: 100%; height: 48px; padding: 0 12px; border: 1px solid #e5eaf2; border-radius: 8px; color: #101b2b; background: #fff; font-size: 16px; }
.admin-primary, .admin-secondary { min-height: 44px; border-radius: 8px; font-size: 16px; line-height: 26px; padding: 10px 16px; }
.admin-primary { width: 100%; margin: 16px 0 0; color: #fff; background: #2860cf; }
.admin-secondary { margin: 12px 0 0 auto; color: #2860cf; background: #edf2ff; }
.admin-primary[disabled], .admin-secondary[disabled] { opacity: .55; }
.backup-record { padding: 16px 0; border-bottom: 1px solid #e5eaf2; }
.backup-record:last-child { border-bottom: 0; padding-bottom: 0; }
.backup-record-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 16px; font-weight: 500; line-height: 26px; }
.backup-size { flex-shrink: 0; color: #6b788a; font-size: 14px; font-weight: 400; }
.backup-count { display: block; margin-top: 6px; color: #526173; font-size: 14px; line-height: 24px; }
.admin-state, .admin-empty { display: block; padding: 24px 0; color: #526173; font-size: 14px; text-align: center; line-height: 24px; }
.admin-error { padding: 16px; border: 1px solid #ecd4d0; border-radius: 9px; color: #ad4037; font-size: 16px; line-height: 26px; background: #fffaf9; }
.admin-error button { min-height: 44px; margin-top: 12px; color: #2860cf; background: #edf2ff; border-radius: 8px; font-size: 16px; }
@media (max-width: 350px) { .module-page { padding-left: 12px; padding-right: 12px; } }

.module-page { box-sizing: border-box; min-height: 100vh; padding: 17px 16px calc(26px + env(safe-area-inset-bottom)); background: #f3f5f9; }
.document-page { background: #fff; }
.module-card { border-color: #e9edf5; border-radius: 14px; padding: 38px 22px; }
.module-card image { width: 52px; height: 52px; margin-bottom: 18px; }
.module-card > imc-icon { margin-bottom: 17px; }
.module-title { font-size: 19px; line-height: 29px; }
.module-status { font-size: 15px; color: #718095; }
.settings-card { border-radius: 14px; border-color: #e9edf5; }
.settings-row { min-height: 60px; border-bottom-color: #edf0f4; padding: 11px 0; }
.admin-card { border-radius: 14px; border-color: #e9edf5; padding: 18px; }
.admin-title { font-size: 19px; line-height: 29px; margin-bottom: 15px; }
.admin-field { min-height: 53px; padding: 13px 0; border-color: #edf0f4; font-size: 15px; }
.admin-field > text:first-child { font-size: 13px; color: #6b788a; }
.backup-label { font-size: 14px; line-height: 22px; margin-top: 18px; margin-bottom: 8px; }
.backup-password { height: 48px; border-radius: 9px; border-color: #e4e8ef; background: #fafbfd; }
.admin-primary, .admin-secondary { min-height: 46px; border-radius: 10px; padding: 11px 13px; line-height: 24px; }
.admin-secondary { width: 100%; }
.backup-record { border-color: #e7ecf3; }
.backup-record-head { font-size: 15px; }
.backup-count { font-size: 13px; color: #6b788a; }
.backup-size { font-size: 13px; }
