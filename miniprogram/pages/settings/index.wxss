.settings-page { box-sizing: border-box; min-height: 100vh; padding: 18px 16px calc(26px + env(safe-area-inset-bottom)); color: #101b2b; background: #f3f5f9; }
.settings-group { margin-bottom: 22px; }
.group-title { display: block; padding: 0 5px; margin-bottom: 8px; color: #6b788a; font-size: 13px; line-height: 22px; }
.settings-card { padding: 0 16px; border: 1px solid #e9edf5; border-radius: 14px; background: #fff; }
.settings-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; width: 100%; min-height: 60px; margin: 0; padding: 15px 0; border-bottom: 1px solid #edf0f4; border-radius: 0; color: #101b2b; background: #fff; font-size: 16px; line-height: 26px; text-align: left; }
.settings-row:last-child { border-bottom: 0; }
.settings-row > text:first-child { min-width: 0; overflow-wrap: anywhere; }
.row-pressed { background: #f5f7fb; }
.row-end { display: flex; align-items: center; justify-content: flex-end; gap: 9px; min-width: 0; max-width: 55%; }
.row-value { min-width: 0; color: #6b788a; text-align: right; overflow-wrap: anywhere; font-size: 13px; line-height: 21px; }
.arrow, .faq-chevron { flex-shrink: 0; color: #9aa7ba; font-size: 24px; line-height: 24px; }
.exit-button { display: block; box-sizing: border-box; width: 100%; min-height: 48px; margin: 26px 0 0; padding: 11px 16px; border: 1px solid #e9edf5; border-radius: 14px; color: #101b2b; background: #fff; font-size: 16px; line-height: 26px; }
.info-card { padding: 0 18px; }
.info-row { display: flex; box-sizing: border-box; align-items: flex-start; justify-content: space-between; gap: 18px; min-height: 55px; padding: 15px 0; border-bottom: 1px solid #edf0f4; font-size: 15px; line-height: 25px; }
.info-row:last-child { border-bottom: 0; }
.info-label { flex-shrink: 0; color: #6b788a; }
.info-value { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 0 8px; min-width: 0; text-align: right; overflow-wrap: anywhere; }
.info-value > text { min-width: 0; max-width: 100%; }
.text-button { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; min-height: 44px; margin: -9px 0; padding: 9px 0; color: #2860cf; background: transparent; border-radius: 0; font-size: 14px; line-height: 26px; }
.action-card { margin-top: 14px; }
.content-card { padding: 18px; margin-bottom: 14px; }
.card-title { display: block; margin-bottom: 14px; font-size: 18px; font-weight: 600; line-height: 28px; }
.content-section + .content-section { margin-top: 18px; }
.content-title { display: block; margin-bottom: 5px; font-size: 15px; font-weight: 500; line-height: 25px; }
.body-text { display: block; color: #526173; font-size: 15px; line-height: 26px; overflow-wrap: anywhere; white-space: pre-wrap; }
.paragraph { margin-top: 12px; }
.muted { display: block; color: #6b788a; font-size: 14px; line-height: 24px; }
.primary, .secondary { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 48px; margin: 20px 0 0; padding: 11px 14px; border-radius: 10px; font-size: 16px; line-height: 26px; }
.primary { color: #fff; background: #2860cf; }
.secondary { color: #2860cf; background: #edf2ff; }
.storage-summary { padding: 26px 18px; text-align: center; }
.storage-size { display: block; margin: 8px 0; font-size: 30px; font-weight: 600; line-height: 42px; overflow-wrap: anywhere; }
.inline-error { margin-top: 15px; color: #ad4037; font-size: 14px; line-height: 24px; }
.inline-error text { display: block; }
.state { padding: 32px 0; color: #6b788a; font-size: 15px; line-height: 26px; text-align: center; }
.error-card { padding: 18px; border: 1px solid #ecd4d0; border-radius: 14px; color: #ad4037; background: #fff; font-size: 15px; line-height: 26px; }
.faq-item { border-bottom: 1px solid #edf0f4; }
.faq-item:last-child { border-bottom: 0; }
.faq-question { display: flex; align-items: center; justify-content: space-between; gap: 14px; width: 100%; min-height: 62px; margin: 0; padding: 16px 0; border-radius: 0; color: #101b2b; background: #fff; font-size: 16px; line-height: 26px; text-align: left; }
.faq-question > text:first-child { flex: 1; min-width: 0; }
.faq-chevron { transform: rotate(90deg); }
.faq-chevron.expanded { transform: rotate(-90deg); }
.faq-answer { display: block; padding-bottom: 18px; color: #526173; font-size: 15px; line-height: 27px; overflow-wrap: anywhere; }
.about-brand { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 24px 0 30px; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 76px; height: 76px; border-radius: 20px; color: #2860cf; background: #e8eeff; font-size: 24px; font-weight: 600; line-height: 32px; }
.brand-name { margin-top: 4px; font-size: 21px; font-weight: 600; line-height: 32px; }
@media (max-width: 350px) { .settings-page { padding-left: 12px; padding-right: 12px; } .settings-card { padding-left: 14px; padding-right: 14px; } .content-card { padding: 16px 14px; } .info-row { gap: 12px; } .settings-row { gap: 10px; } }
