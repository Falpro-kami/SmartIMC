@import "../../styles/controls.wxss";
:host { display: block; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.membership-screen { position: fixed; inset: 0; z-index: 200; box-sizing: border-box; padding: 84px 16px calc(24px + env(safe-area-inset-bottom)); background: #fff; color: #101b2b; overflow-y: auto; }
.brand-title { display: block; margin: 0 0 28px; text-align: center; font-size: 20px; font-weight: 600; line-height: 30px; }
.membership-card { padding: 24px 16px; border: 1px solid #e5eaf2; border-radius: 10px; background: #fff; }
.gate-title { display: block; font-size: 20px; font-weight: 600; line-height: 30px; }
.avatar-button { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; margin: 24px 0; padding: 0; overflow: hidden; border-radius: 50%; background: #f4f6f9; color: #526173; font-size: 14px; }
.avatar-button image { width: 100%; height: 100%; }
button::after { border: 0; }
.field-label { display: block; margin: 0 0 10px; font-size: 16px; line-height: 24px; color: #526173; }
.name-input { box-sizing: border-box; width: 100%; height: 48px; padding: 0 12px; border: 1px solid #e5eaf2; border-radius: 8px; color: #101b2b; font-size: 16px; }
.gate-primary, .gate-secondary { width: 100%; min-height: 44px; margin: 24px 0 0; padding: 10px 16px; border-radius: 8px; font-size: 16px; line-height: 26px; }
.gate-primary { color: #fff; background: #2860cf; }
.gate-secondary { color: #2860cf; background: #edf2ff; }
.gate-state { display: block; margin-top: 16px; color: #526173; font-size: 16px; line-height: 26px; }
.gate-error { display: block; margin-top: 12px; color: #ad4037; font-size: 14px; line-height: 24px; overflow-wrap: anywhere; }
@media (max-width: 350px) { .membership-screen { padding-left: 12px; padding-right: 12px; } }

.membership-screen { min-height: 100vh; box-sizing: border-box; background: #f3f5f9; }
.brand-title { font-size: 25px; line-height: 37px; }
.membership-card { border-color: #e9edf5; border-radius: 14px; padding: 25px 21px 27px; }
.gate-title { font-size: 21px; line-height: 32px; }
.avatar-button { border-radius: 20px; background: #edf2ff; color: #2860cf; }
.name-input { border-color: #e4e8ef; border-radius: 9px; background: #fafbfd; }
.gate-primary, .gate-secondary { border-radius: 10px; min-height: 46px; }
