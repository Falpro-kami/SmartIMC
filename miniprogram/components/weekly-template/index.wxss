:host { display: block; }
.templates { font-size: 16px; line-height: 1.6; color: #101b2b; }
.heading,.row { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 48px; }
.heading-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.title { font-size: 20px; font-weight: 600; } .name { font-weight: 600; overflow-wrap: anywhere; }
.card { box-sizing: border-box; padding: 18px; border: 1px solid #dde3ec; border-radius: 10px; margin-top: 16px; background: #fff; }
.field { border-top: 1px solid #dde3ec; margin-top: 12px; padding-top: 4px; }
.node-title { display: block; font-size: 18px; font-weight: 600; margin-top: 12px; overflow-wrap: anywhere; }
.label { display: block; margin: 12px 0 8px; color: #526173; }
.input { box-sizing: border-box; min-height: 48px; width: 100%; border: 1px solid #dde3ec; border-radius: 8px; padding: 0 12px; font-size: 16px; background: #fff; color: #101b2b; }
.options { padding: 12px; min-height: 120px; } .picker { min-height: 44px; line-height: 44px; color: #005bac; }
.actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
button { box-sizing: border-box; margin: 0; min-height: 44px; padding: 8px 12px; border-radius: 8px; font-size: 16px; line-height: 28px; } button::after { border: 0; } button[disabled] { opacity: .5; }
.primary { color: #fff; background: #005bac; } .secondary { color: #005bac; background: #edf3f8; } .link { color: #005bac; background: #fff; font-size: 14px; }
.danger,.error { color: #ad4037; } .error { display: block; margin-top: 12px; overflow-wrap: anywhere; } .wide { margin-top: 14px; width: 100%; }
.empty { padding: 24px; color: #526173; text-align: center; }
@media (max-width: 350px) { .card { padding: 12px; } }
