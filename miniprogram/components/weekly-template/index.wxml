<view class="templates">
  <view class="heading"><text class="title">{{editing ? '编辑模板' : '表单模板'}}</text><button class="link" bindtap="back" disabled="{{busy}}">返回</button></view>
  <view wx:if="{{loading}}" class="empty">正在读取…</view>
  <block wx:elif="{{!editing}}">
    <view wx:if="{{!templates.length}}" class="card empty">暂无模板</view>
    <view wx:for="{{templates}}" wx:key="id" class="card"><text class="name">{{item.name}}</text><view class="actions"><button class="secondary" data-id="{{item.id}}" bindtap="edit">编辑</button><button wx:if="{{choose}}" class="primary" data-id="{{item.id}}" bindtap="chooseTemplate">使用</button></view></view>
    <button class="primary wide" bindtap="newTemplate">新建模板</button>
  </block>
  <block wx:else>
    <view class="card"><text class="label">模板名称</text><input class="input" value="{{editing.name}}" bindinput="name" maxlength="60" disabled="{{busy}}" /></view>
    <view wx:for="{{editing.schema.sections}}" wx:key="id" wx:for-item="section" wx:for-index="si" class="card">
      <text class="label">分区标题</text><input class="input" value="{{section.title}}" data-section="{{si}}" bindinput="sectionInput" maxlength="60" disabled="{{busy}}" />
      <view class="actions"><button class="link" data-section="{{si}}" data-step="-1" bindtap="moveSection" disabled="{{busy || si === 0}}">上移分区</button><button class="link" data-section="{{si}}" data-step="1" bindtap="moveSection" disabled="{{busy || si === editing.schema.sections.length - 1}}">下移分区</button><button class="link danger" data-section="{{si}}" bindtap="removeSection" disabled="{{busy}}">删除分区</button></view>
      <view wx:for="{{section.fields}}" wx:key="id" wx:for-item="field" wx:for-index="fi" class="field">
        <text class="label">字段名称</text><input class="input" value="{{field.label}}" data-section="{{si}}" data-field="{{fi}}" data-key="label" bindinput="fieldInput" maxlength="60" disabled="{{busy}}" />
        <view class="row"><text>字段类型</text><picker range="{{types}}" data-section="{{si}}" data-field="{{fi}}" bindchange="type" disabled="{{busy}}"><view class="picker">{{field.type === 'text' ? '文本' : field.type === 'number' ? '数字' : field.type === 'date' ? '日期' : field.type === 'single' ? '单选' : field.type === 'multiple' ? '多选' : '附件'}} ›</view></picker></view>
        <view class="row"><text>必填</text><switch color="#005bac" checked="{{field.required}}" data-section="{{si}}" data-field="{{fi}}" data-key="required" bindchange="fieldInput" disabled="{{busy}}" /></view>
        <view class="row"><text>并排展示</text><switch color="#005bac" checked="{{field.width === 'half'}}" data-section="{{si}}" data-field="{{fi}}" data-key="width" bindchange="fieldInput" disabled="{{busy}}" /></view>
        <block wx:if="{{field.type === 'text'}}"><text class="label">字数上限</text><input class="input" type="number" value="{{field.maxLength}}" data-section="{{si}}" data-field="{{fi}}" data-key="maxLength" bindinput="fieldInput" disabled="{{busy}}" /></block>
        <block wx:if="{{field.type === 'single' || field.type === 'multiple'}}"><text class="label">选项（每行一个）</text><textarea class="input options" value="{{field.optionsText}}" data-section="{{si}}" data-field="{{fi}}" data-key="options" bindinput="fieldInput" maxlength="2500" disabled="{{busy}}" /></block>
        <block wx:if="{{field.type === 'attachment'}}"><text class="label">附件数量上限</text><input class="input" type="number" value="{{field.maxCount}}" data-section="{{si}}" data-field="{{fi}}" data-key="maxCount" bindinput="fieldInput" disabled="{{busy}}" /><text class="label">单个附件上限（MB）</text><input class="input" type="number" value="{{field.maxSizeMB}}" data-section="{{si}}" data-field="{{fi}}" data-key="maxSizeMB" bindinput="fieldInput" disabled="{{busy}}" /></block>
        <view class="actions"><button class="link" data-section="{{si}}" data-field="{{fi}}" data-step="-1" bindtap="moveField" disabled="{{busy || fi === 0}}">上移</button><button class="link" data-section="{{si}}" data-field="{{fi}}" data-step="1" bindtap="moveField" disabled="{{busy || fi === section.fields.length - 1}}">下移</button><button class="link danger" data-section="{{si}}" data-field="{{fi}}" bindtap="removeField" disabled="{{busy}}">删除字段</button></view>
      </view>
      <button class="secondary wide" data-section="{{si}}" bindtap="addField" disabled="{{busy}}">＋ 添加字段</button>
    </view>
    <button class="secondary wide" bindtap="addSection" disabled="{{busy}}">＋ 添加分区</button>
    <button class="primary wide" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存模板</button>
  </block>
  <text wx:if="{{error}}" class="error">{{error}}</text>
</view>
