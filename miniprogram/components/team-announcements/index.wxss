@import "../../styles/controls.wxss";
:host { display: block; color: #101b2b; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
button { box-sizing: border-box; font-family: inherit; }
button::after { border: 0; }
.announcement-toolbar { display: flex; justify-content: flex-end; min-height: 0; gap: 12px; }
.announcement-toolbar button { margin: 0 0 14px; }
.announcement-card { box-sizing: border-box; width: 100%; margin: 0 0 14px; padding: 18px 16px; border: 1px solid #e5eaf2; border-radius: 10px; background: #fff; color: #101b2b; }
.announcement-row { display: flex; align-items: center; gap: 12px; text-align: left; line-height: 1.5; }
.announcement-info { flex: 1; min-width: 0; }
.announcement-title-line { display: flex; gap: 8px; align-items: baseline; }
.announcement-title { flex: 1; min-width: 0; font-size: 16px; font-weight: 600; overflow-wrap: anywhere; }
.pinned-tag { flex-shrink: 0; display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 12px; line-height: 20px; background: #edf2ff; color: #2860cf; }
.announcement-meta { display: block; margin-top: 8px; font-size: 13px; color: #6b788a; line-height: 22px; overflow-wrap: anywhere; }
.announcement-arrow { flex-shrink: 0; color: #6b788a; font-size: 24px; }
.detail-title { display: block; margin-top: 8px; font-size: 20px; font-weight: 600; line-height: 30px; overflow-wrap: anywhere; }
.announcement-body { display: block; margin-top: 24px; font-size: 16px; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; }
.primary-action, .secondary-action, .danger-action, .text-action { min-height: 44px; margin: 0; padding: 10px 16px; border-radius: 8px; font-size: 16px; line-height: 24px; }
.primary-action { color: #fff; background: #2860cf; }
.secondary-action { color: #2860cf; background: #edf2ff; }
.danger-action { color: #ad4037; background: #fbefed; }
.text-action { margin-right: auto !important; padding-left: 0; color: #2860cf; background: transparent; }
.full-width { width: 100%; }
.detail-actions { display: flex; gap: 12px; }
.detail-actions button { flex: 1; }
.field-label { display: block; margin-bottom: 10px; font-size: 16px; line-height: 24px; color: #526173; }
.body-label { margin-top: 20px; }
.title-input, .body-input { box-sizing: border-box; width: 100%; padding: 12px; border: 1px solid #e5eaf2; border-radius: 8px; color: #101b2b; background: #fff; font-size: 16px; line-height: 26px; }
.title-input { height: 48px; }
.body-input { min-height: 220px; }
.pin-field { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 52px; margin-top: 16px; font-size: 16px; }
.announcement-state { display: block; padding: 32px 0; text-align: center; color: #6b788a; font-size: 14px; line-height: 24px; }
.announcement-error { padding: 16px; border: 1px solid #ecd4d0; border-radius: 10px; color: #ad4037; font-size: 16px; line-height: 26px; }
.announcement-error button { margin-top: 12px; }
.form-error { display: block; margin-bottom: 12px; color: #ad4037; font-size: 14px; line-height: 24px; }
@media (max-width: 350px) { .announcement-card { padding-left: 12px; padding-right: 12px; } }

.announcement-card { padding: 18px; border-color: #e9edf5; border-radius: 14px; }
.announcement-row { gap: 12px; }
.announcement-symbol { align-self: flex-start; margin-top: 3px; flex-shrink: 0; }
.announcement-title { font-size: 16px; line-height: 25px; font-weight: 500; }
.announcement-meta { color: #6b788a; font-size: 12px; margin-top: 4px; line-height: 21px; }
.detail-title { font-size: 22px; line-height: 1.55; margin-top: 10px; }
.announcement-body { line-height: 1.95; margin-top: 23px; }
.primary-action, .secondary-action, .danger-action { border-radius: 10px; min-height: 46px; padding: 11px 13px; }
.field-label { font-size: 14px; line-height: 22px; margin-bottom: 8px; }
.title-input, .body-input { border-color: #e4e8ef; border-radius: 9px; background: #fafbfd; }
.pinned-tag { border-radius: 4px; font-size: 11px; }
