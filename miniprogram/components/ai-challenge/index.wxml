<view class="challenge">
  <block wx:if="{{mode === 'list'}}">
    <view class="heading"><text>AI 挑战赛</text><button wx:if="{{canManage}}" class="small-primary" bindtap="editEvent">＋ 发布赛事</button></view>
    <button wx:if="{{canManage}}" class="teacher-link" bindtap="openTeacher">{{teacher && teacher.id ? '陈老师查看权限' : '陈老师尚未绑定账号'}}<text>›</text></button>
    <scroll-view class="filter-scroll" scroll-x><view class="filters"><button wx:for="{{filters}}" wx:key="id" class="filter {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeFilter">{{item.label}}<view wx:if="{{filter === item.id}}" class="filter-line"></view></button></view></scroll-view>
    <view wx:if="{{!events.length && !loading && !error}}" class="empty">暂无{{filter === 'open' ? '进行中的' : ''}}赛事</view>
    <button wx:for="{{events}}" wx:key="id" class="event-card" data-id="{{item.id}}" bindtap="openEvent"><view class="event-card-top"><text class="event-name">{{item.name}}</text><text class="tag {{item.phase}}">{{item.phaseLabel}}</text></view><text class="meta">开始　{{item.startLabel}}</text><text class="meta">截止　{{item.endLabel}}</text><view class="list-metrics"><text>{{item.groupCount}} 组报名</text><text>{{item.workCount}} 组提交</text><text class="arrow">›</text></view></button>
    <button wx:if="{{hasMore && !loading}}" class="secondary" bindtap="loadMore">加载更多赛事</button>
  </block>
  <block wx:elif="{{mode === 'editor' && form}}">
    <view class="heading"><text>{{form.revision ? '编辑赛事' : '发布赛事'}}</text><button class="text-button" bindtap="cancelEditor" disabled="{{busy}}">取消</button></view>
    <view class="panel"><text class="label">挑战赛名称</text><input class="field" value="{{form.name}}" data-field="name" bindinput="changeForm" maxlength="80" placeholder="填写挑战赛名称" disabled="{{busy}}" />
      <text class="label">开始时间</text><view class="picker-row"><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="changeForm" disabled="{{busy || form.timeLocked}}"><view class="field">{{form.startDate}}<text>›</text></view></picker><picker mode="time" value="{{form.startTime}}" data-field="startTime" bindchange="changeForm" disabled="{{busy || form.timeLocked}}"><view class="field">{{form.startTime}}<text>›</text></view></picker></view>
      <text class="label">截止时间</text><view class="picker-row"><picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="changeForm" disabled="{{busy || form.timeLocked}}"><view class="field">{{form.endDate}}<text>›</text></view></picker><picker mode="time" value="{{form.endTime}}" data-field="endTime" bindchange="changeForm" disabled="{{busy || form.timeLocked}}"><view class="field">{{form.endTime}}<text>›</text></view></picker></view>
      <text wx:if="{{form.timeLocked}}" class="hint">已有队伍报名，开始和截止时间已锁定。</text>
      <text class="label">首页封面</text><text wx:if="{{form.cover}}" class="file-name">{{form.cover.name}}</text><button class="secondary" data-kind="cover" bindtap="chooseEventFile" disabled="{{busy}}">{{form.cover ? '更换封面' : '选择封面图片'}}</button><text class="hint">JPG、PNG，最大2MB，建议使用横向图片。</text>
      <text class="label">赛事介绍文件</text><text wx:if="{{form.intro}}" class="file-name">{{form.intro.name}}</text><button class="secondary" data-kind="intro" bindtap="chooseEventFile" disabled="{{busy}}">{{form.intro ? '更换介绍文件' : '上传介绍文件'}}</button><text class="hint">PDF、Word、PPT、Excel，最大20MB。</text>
      <button class="primary" bindtap="saveEvent" loading="{{busy}}" disabled="{{busy || !form.name || !form.cover || !form.intro}}">{{form.revision ? '保存赛事' : '发布赛事'}}</button>
    </view>
  </block>
  <block wx:elif="{{mode === 'teacher'}}">
    <view class="heading"><text>陈老师查看权限</text><button class="text-button" bindtap="cancelEditor" disabled="{{busy}}">返回</button></view>
    <view class="panel"><text class="section-title">绑定真实成员账号</text><text class="hint">陈老师加入团队并通过成员审核后，由高创确认账号。绑定后可查看全部报名队伍和作品。</text><picker range="{{teacherChoices}}" range-key="name" value="{{teacherIndex}}" bindchange="changeTeacher" disabled="{{busy}}"><view class="field">{{teacherIndex >= 0 ? teacherChoices[teacherIndex].name : '选择陈老师的成员账号'}}<text>›</text></view></picker><text wx:if="{{teacherIndex >= 0}}" class="account-id">{{teacherChoices[teacherIndex].id}}</text><button class="primary" bindtap="bindTeacher" disabled="{{busy || teacherIndex < 0}}">确认绑定</button></view>
  </block>
  <block wx:elif="{{mode === 'detail' && selected && !error}}">
    <view class="heading"><text>AI 挑战赛</text><button class="text-button" bindtap="back" disabled="{{busy}}">全部赛事</button></view>
    <view class="hero"><image wx:if="{{coverPath}}" class="hero-image" src="{{coverPath}}" mode="aspectFill" /><view class="hero-shade"></view><view class="hero-content"><view class="hero-top"><text class="hero-tag">{{selected.phaseLabel}}</text><button wx:if="{{selected.canManage && selected.phase !== 'closed'}}" class="hero-edit" bindtap="editEvent">编辑赛事</button></view><text class="hero-title">{{selected.name}}</text><view class="hero-dates"><text>开始　{{selected.startLabel}}</text><text>截止　{{selected.endLabel}}</text></view></view></view>
    <view class="metrics"><view><text class="metric-value">{{selected.groupCount}}</text><text class="metric-label">已报名队伍</text></view><view><text class="metric-value green">{{selected.workCount}}</text><text class="metric-label">已提交作品</text></view></view>
    <view class="quick-grid"><button data-tab="overview" bindtap="changeTab">赛事介绍</button><button data-tab="teams" bindtap="changeTab">{{selected.canReview ? '报名队伍' : '我的队伍'}}</button><button data-tab="works" bindtap="changeTab">{{selected.canReview ? '队伍作品' : '本组作品'}}</button><button data-tab="results" bindtap="changeTab">评分与位次</button></view>
    <view class="tabs"><button class="{{tab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="changeTab">介绍</button><button class="{{tab === 'teams' ? 'active' : ''}}" data-tab="teams" bindtap="changeTab">报名</button><button class="{{tab === 'works' ? 'active' : ''}}" data-tab="works" bindtap="changeTab">作品</button><button class="{{tab === 'results' ? 'active' : ''}}" data-tab="results" bindtap="changeTab">成绩</button></view>
    <view wx:if="{{tab === 'overview'}}" class="panel"><text class="section-title">赛事介绍</text><button class="file-row" data-kind="intro" bindtap="openFile" disabled="{{busy || downloadId}}"><view class="file-symbol">PDF</view><view class="file-main"><text>{{selected.intro.name}}</text><text class="meta">{{selected.intro.sizeLabel}}</text></view><text class="file-action">查看</text></button><button class="primary" data-tab="teams" bindtap="changeTab">{{selected.canReview ? '查看报名队伍' : myTeam ? '查看我的队伍' : selected.canRegister ? '组队报名' : '查看报名状态'}}</button></view>
    <block wx:elif="{{tab === 'teams'}}">
      <block wx:if="{{selected.canReview}}"><view class="section-heading"><text>报名队伍</text><text class="meta">共 {{selected.groupCount}} 组</text></view><view wx:if="{{!teams.length}}" class="empty">暂无报名</view><view wx:for="{{teams}}" wx:key="id" class="panel team-card"><view class="team-heading"><text>{{item.name}}</text><text class="tag {{item.work ? 'submitted' : 'muted'}}">{{item.work ? '已提交' : '待提交'}}</text></view><text class="meta">组长：{{item.leaderName}}</text><text class="meta">成员：{{item.membersLabel}}</text></view><button wx:if="{{teamsMore}}" class="secondary" bindtap="loadMoreTeams">更多报名组</button></block>
      <view wx:elif="{{myTeam && !registerEdit}}" class="panel"><view class="team-heading"><text>{{myTeam.name}}</text><text class="tag submitted">已报名</text></view><text class="meta">组长：{{myTeam.leaderName}}</text><text class="meta">成员：{{myTeam.membersLabel}}</text><button wx:if="{{myTeam.canEdit}}" class="secondary" bindtap="editRegistration">修改报名信息</button></view>
      <view wx:elif="{{!selected.canRegister}}" class="empty">报名已截止{{myTeam ? '' : '，你尚未报名本次赛事'}}</view>
      <view wx:else class="panel"><text class="section-title">参赛组信息</text><text class="label">组名</text><input class="field" value="{{groupName}}" bindinput="changeGroup" maxlength="30" placeholder="填写参赛组名" disabled="{{busy}}" /><text class="label">组长</text><view class="field">{{leaderName || '正在读取成员信息…'}}（我）</view><text class="label">组内成员</text><checkbox-group class="member-options" bindchange="changeMembers"><label wx:for="{{members}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.selected}}" disabled="{{busy}}" color="#2860cf" />{{item.name}}</label></checkbox-group><text class="hint">每人每场赛事只能加入一组。组内成员可共同提交和查看本组作品。</text><button class="primary" bindtap="register" disabled="{{busy || !groupName || !leaderName}}" loading="{{busy}}">{{myTeam ? '保存报名信息' : '确认报名'}}</button></view>
    </block>
    <block wx:elif="{{tab === 'works'}}">
      <block wx:if="{{selected.canReview}}"><view class="section-heading"><text>最新提交作品</text><text class="meta">{{selected.workCount}} / {{selected.groupCount}} 组</text></view><view wx:if="{{!teams.length}}" class="empty">暂无参赛组</view><view wx:for="{{teams}}" wx:key="id" class="panel team-card"><view class="team-heading"><text>{{item.name}}</text><text class="tag {{item.work ? 'submitted' : 'muted'}}">{{item.work ? '已提交' : '待提交'}}</text></view><text class="meta">组长：{{item.leaderName}}　成员：{{item.membersLabel}}</text><button wx:if="{{item.work}}" class="file-row" data-kind="work" data-group="{{item.id}}" bindtap="openFile" disabled="{{busy || downloadId}}"><view class="file-main"><text>{{item.work.file.name}}</text><text class="meta">第{{item.work.version}}次提交 · {{item.work.uploadedLabel}}</text></view><text class="file-action">查看</text></button><text wx:else class="hint">尚未提交作品</text></view><button wx:if="{{teamsMore}}" class="secondary" bindtap="loadMoreTeams">更多队伍作品</button><text class="hint">全部组作品仅高创和陈老师可查看。</text></block>
      <view wx:elif="{{!myTeam}}" class="panel empty">报名后可提交本组作品。<button class="primary" data-tab="teams" bindtap="changeTab" disabled="{{!selected.canRegister}}">{{selected.canRegister ? '前往报名' : '报名已截止'}}</button></view>
      <view wx:else class="panel"><view class="team-heading"><text>{{myTeam.name}}</text><text class="tag {{myTeam.work ? 'submitted' : 'muted'}}">{{myTeam.work ? '已提交' : '待提交'}}</text></view><button wx:if="{{myTeam.work}}" class="file-row" data-kind="work" bindtap="openFile" disabled="{{busy || downloadId}}"><view class="file-main"><text>{{myTeam.work.file.name}}</text><text class="meta">第{{myTeam.work.version}}次提交 · {{myTeam.work.uploadedLabel}}</text></view><text class="file-action">查看</text></button><text wx:else class="hint">尚未提交最终作品。</text><block wx:if="{{myTeam.canUpload}}"><button class="upload-box" bindtap="chooseWork" disabled="{{busy}}"><text>＋ 选择最终作品</text><text class="meta">PDF、Word、PPT、Excel，最大20MB</text></button><text wx:if="{{draftWork}}" class="draft-file">待提交：{{draftWork.name}}</text><button class="primary" bindtap="submitWork" loading="{{busy}}" disabled="{{busy || !draftWork}}">{{myTeam.work ? '覆盖并提交新作品' : '提交最终作品'}}</button><text class="hint">重新提交将覆盖旧文件。仅本组成员、高创和陈老师可查看。</text></block><text wx:else class="hint">提交已截止，当前作品已锁定。</text></view>
    </block>
    <block wx:elif="{{tab === 'results'}}">
      <view wx:if="{{selected.phase !== 'closed'}}" class="empty">比赛截止后，由高创公布评分与位次。</view>
      <block wx:else>
        <view wx:if="{{selected.canManage}}" class="panel"><text class="section-title">发布赛事成绩</text><text class="hint">CSV须包含“组名、总分、位次”，可添加评分明细列。支持UTF-8、GB18030，最大256KB，需覆盖全部报名组。</text><button class="upload-box" bindtap="chooseScores" disabled="{{busy}}">{{scoreFile ? scoreFile.name : '＋ 上传 CSV 评分表'}}</button><view wx:if="{{scorePreview}}" class="score-preview"><text class="hint">待公布预览 · {{scorePreview.entries.length}} 组</text><view wx:for="{{scorePreview.entries}}" wx:key="groupName" class="score-row"><text>{{item.rank}}</text><text class="score-name">{{item.groupName}}</text><text>{{item.score}}</text></view></view><button class="primary" bindtap="publishResults" disabled="{{busy || !scoreFile}}" loading="{{busy}}">{{selected.results ? '更新并公布成绩' : '公布评分与位次'}}</button><text class="hint">公布后，团队成员可查看评分表和组排名；作品不会公开。</text></view>
        <view wx:if="{{selected.results}}" class="panel"><view class="team-heading"><text>报名组位次</text><text class="tag submitted">已公布</text></view><view class="score-row score-head"><text>位次</text><text class="score-name">参赛组</text><text>总分</text></view><view wx:for="{{selected.results.entries}}" wx:key="groupName" class="score-row"><text class="rank">{{item.rank}}</text><text class="score-name">{{item.groupName}}</text><text class="score-value">{{item.score}}</text></view><button class="file-row" data-kind="scores" bindtap="openFile" disabled="{{busy || downloadId}}"><view class="file-main"><text>{{selected.results.file.name}}</text><text class="meta">完整评分表 · {{selected.results.file.sizeLabel}}</text></view><text class="file-action">导出</text></button></view>
        <view wx:else class="empty">评分结果尚未公布</view>
      </block>
    </block>
  </block>
  <view wx:if="{{loading}}" class="state">正在读取…</view><view wx:if="{{error}}" class="error"><text>{{error}}</text><button bindtap="retry">重试</button></view><text wx:if="{{actionError}}" class="action-error">{{actionError}}</text><text wx:if="{{downloadId}}" class="hint">正在读取文件 {{progress}}%</text>
</view>
