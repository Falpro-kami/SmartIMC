<view class="weekly imc-theme {{mode === 'form' ? 'has-form-footer' : ''}} {{mode === 'detail' && selected && own && !isLeader && (selected.ownStatus !== 'outside' && selected.ownStatus !== 'exempt' || report || versions.length) ? 'has-submission-footer' : ''}}">
  <weekly-template id="template-panel" wx:if="{{templatesOpen}}" choose="{{choosingTemplate}}" edit-id="{{initialTemplate}}" local-template="{{periodTemplate}}" bindedit="editTemplate" bindpreview="previewTemplate" binddone="closeTemplates" bindclose="closeTemplates" bindselect="selectTemplate" />
  <block wx:elif="{{mode === 'preview'}}">

    <view wx:if="{{preview}}">
      <view wx:if="{{previewKind === 'template'}}" class="filters"><button class="{{previewMode === 'outline' ? 'active' : ''}}" data-mode="outline" bindtap="previewMode">模板结构</button><button class="{{previewMode === 'reading' ? 'active' : ''}}" data-mode="reading" bindtap="previewMode">阅读效果</button></view>
      <view class="preview-document"><text class="preview-name">{{preview.memberName || '-'}}</text>
        <weekly-fields wx:if="{{preview.schema}}" schema="{{preview.schema}}" answers="{{preview.answers}}" selected-fields="{{preview.selectedFields}}" files="{{preview.files}}" image-urls="{{preview.imageURLs}}" readonly embedded outline="{{previewKind === 'template' && previewMode === 'outline'}}" bindfile="fieldFile" />
        <block wx:else><text wx:if="{{!preview.files.length}}" class="empty">暂无文件</text><view wx:for="{{preview.files}}" wx:key="id" class="file-row"><view class="file-info"><text class="file-name">{{item.name}}</text><text class="meta">{{item.sizeLabel}}</text></view><button class="text-button" data-id="{{item.id}}" bindtap="useFile">查看</button></view></block>
      </view>
    </view><view wx:else class="error">{{error}}</view>
  </block>
  <block wx:else>
  <view wx:if="{{mode !== 'form' && (mode !== 'detail' || isLeader || !own || !selected || !selected.canEdit)}}" class="toolbar {{mode === 'list' ? 'list-toolbar' : ''}}">
    <text class="section-title {{mode === 'list' ? 'page-title' : ''}}">{{mode === 'list' ? (isLeader ? '周报列表' : '我的周报') : mode === 'team' ? '团队提交' : mode === 'form' ? (form.revision ? '周期设置' : '发布周报') : own && !isLeader && selected && selected.canEdit ? '填写周报' : '周报详情'}}</text>
    <button wx:if="{{mode !== 'list'}}" class="text-button" bindtap="backToList" disabled="{{busy}}">周报列表</button>
  </view>
  <view wx:if="{{mode === 'list' && canManage}}" class="toolbar-actions list-management"><button class="text-button" bindtap="manageTemplates" disabled="{{busy}}">表单模板</button><button class="text-button" bindtap="newPeriod" disabled="{{busy}}">发布周报</button></view>
  <view wx:if="{{loading}}" class="empty">正在读取…</view>
  <view wx:elif="{{error}}" class="error"><text>{{error}}</text><button class="secondary" bindtap="refresh">重试</button></view>
  <block wx:elif="{{mode === 'list'}}">
    <view wx:if="{{!listGroups.length}}" class="card empty">暂无周报周期</view>
    <view wx:for="{{listGroups}}" wx:for-item="group" wx:key="id" class="period-group">
      <text wx:if="{{group.id !== 'current'}}" class="group-label">{{group.label}}</text>
      <view wx:for="{{group.rows}}" wx:key="id" class="card period-card {{item.current ? 'current-period' : 'history-period'}}">
        <view class="period-topline"><text class="meta">{{item.current ? '本期周报' : item.periodLabel}}</text><view class="period-status"><text wx:if="{{item.showOwnStatus}}" class="badge {{item.ownBadgeClass}}">{{item.statusLabel}}</text><button wx:if="{{canManage}}" class="more-button" data-id="{{item.id}}" bindtap="periodMenu" disabled="{{busy}}" aria-label="周报管理操作">•••</button></view></view>
        <button class="period-row" data-id="{{item.id}}" bindtap="choosePeriod" disabled="{{busy}}"><text class="period-title">{{item.displayTitle}}</text></button>
        <text wx:if="{{item.showDateRange}}" class="meta">{{item.startDate}} 至 {{item.endDate}}</text>
        <text class="meta period-deadline">截止 {{item.deadlineShort}}</text>
        <text wx:if="{{item.status === 'scheduled'}}" class="meta">发布 {{item.publishLabel}}</text>
        <text wx:if="{{item.edition > 1 || item.supersededBy}}" class="meta">第{{item.edition || 1}}版{{item.supersededBy ? ' · 已修订' : ''}}</text>
        <view class="period-entry-actions {{item.current || item.planned ? 'prominent-actions' : ''}}"><button class="{{item.current || item.planned ? 'primary' : 'text-button'}}" data-id="{{item.id}}" bindtap="enterPeriod" disabled="{{busy}}">{{item.entryLabel}}</button><button wx:if="{{item.secondaryTeam}}" class="{{item.current || item.planned ? 'secondary' : 'text-button'}}" data-id="{{item.id}}" bindtap="teamFromList" disabled="{{busy}}">团队提交</button></view>
      </view>
    </view>
    <button wx:if="{{hasMore}}" class="secondary wide" bindtap="loadMore">加载更多</button>
  </block>
  <block wx:elif="{{mode === 'detail' && selected}}">
    <view class="card detail-summary {{own && !isLeader && selected.canEdit ? 'personal-edit-summary' : ''}}">
      <view class="heading detail-heading"><text class="section-title">{{selected.displayTitle || selected.title}}</text><text wx:if="{{!isLeader || !own}}" class="badge {{selected.ownStatus === 'submitted' && own ? 'success' : own && selected.canEdit ? 'accent-badge' : ''}}">{{own ? selected.statusLabel : '已提交'}}</text></view>
      <text wx:if="{{selected.showDateRange}}" class="meta">{{selected.startDate}} 至 {{selected.endDate}}</text>
      <text class="meta">截止 {{selected.deadlineLabel}}</text>
      <text wx:if="{{!own || isLeader || !selected.canEdit}}" class="meta">{{selected.periodLabel}}</text>
      <view wx:if="{{selected.status === 'scheduled'}}" class="field"><text>发布时间</text><text>{{selected.publishLabel}}</text></view>
      <view wx:if="{{selected.publishError}}" class="error">{{selected.publishError}}</view>
      <view wx:if="{{!own}}" class="field"><text>提交人</text><text>{{ownerName}}</text></view>
      <view wx:if="{{own && !isLeader && selected.exemption}}" class="field"><text>免交原因</text><text>{{selected.exemption}}</text></view>
      <view wx:if="{{report && report.submittedMs && (!isLeader || !own)}}" class="field"><text>最后提交</text><text>{{submittedLabel}}</text></view>
      <view wx:if="{{report && report.hasChanges && own && !isLeader}}" class="meta change-status">有待重新提交的修改</view>
      <view wx:if="{{canReadTeam}}" class="detail-team-action {{isLeader ? 'leader-team-action' : ''}}"><button class="{{isLeader ? 'primary' : 'secondary'}}" bindtap="openTeam" disabled="{{busy}}">查看团队提交</button></view>
      <view wx:if="{{own && canManage && selected.status !== 'deleted'}}" class="management-actions"><button wx:if="{{!selected.supersededBy}}" class="text-button" bindtap="editCurrentPeriod" disabled="{{busy}}">周期设置</button><button class="text-button danger" data-id="{{selected.id}}" bindtap="deletePeriod" disabled="{{busy}}">删除周报</button></view>
      <text wx:if="{{selected.edition > 1 || selected.supersededBy}}" class="meta">第{{selected.edition || 1}}版{{selected.supersededBy ? ' · 已修订' : ''}}</text>
      <view wx:if="{{selected.previousPeriodId || selected.supersededBy}}" class="actions"><button wx:if="{{selected.previousPeriodId}}" class="secondary" data-id="{{selected.previousPeriodId}}" bindtap="openEdition">查看上一版</button><button wx:if="{{selected.supersededBy}}" class="secondary" data-id="{{selected.supersededBy}}" bindtap="openEdition">查看新版</button></view>
    </view>
    <block wx:if="{{selected.schema && (!isLeader || !own) && (!own || (selected.ownStatus !== 'outside' && selected.ownStatus !== 'exempt') || report || versions.length)}}">
      <weekly-fields schema="{{selected.schema}}" answers="{{answers}}" selected-fields="{{selectedFields}}" files="{{files}}" image-urls="{{imageURLs}}" period-id="{{selected.id}}" form-key="{{selected.formKey}}" readonly="{{!own || !selected.canEdit}}" disabled="{{busy}}" bindchange="answersChange" binduploading="formUpload" bindfile="fieldFile" />
      <view wx:if="{{own}}" class="submission-footer"><text wx:if="{{saveState}}" class="meta save-state">{{saveState}}</text><button wx:if="{{saveState === '自动保存失败'}}" class="secondary wide" bindtap="retrySave" disabled="{{busy || formUploading}}">重试自动保存</button><view class="submission-actions"><button class="secondary" bindtap="previewSubmission" loading="{{previewing}}" disabled="{{busy || formUploading || previewing}}">效果预览</button><button wx:if="{{selected.canEdit}}" class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || formUploading || previewing || (report && report.status === 'submitted' && !report.hasChanges && saveState !== '正在自动保存…')}}">{{report && report.status === 'submitted' ? '重新提交' : '提交周报'}}</button></view></view>
    </block>
    <view wx:elif="{{(!isLeader || !own) && (!own || (selected.ownStatus !== 'outside' && selected.ownStatus !== 'exempt') || report || versions.length)}}" class="card">
      <view class="heading"><text class="section-title">周报文件</text></view>
      <text wx:if="{{!files.length}}" class="empty">暂无文件</text>
      <view wx:for="{{files}}" wx:key="id" class="file-row">
        <view class="file-info"><text class="file-name">{{item.name}}</text><text class="meta">{{item.sizeLabel}}</text></view>
        <view class="file-actions"><button class="text-button" data-id="{{item.id}}" bindtap="useFile" disabled="{{busy}}">查看</button><button wx:if="{{own && selected.canEdit}}" class="text-button danger" data-id="{{item.id}}" bindtap="removeFile" disabled="{{busy || saveState === '自动保存失败'}}">移除</button><button wx:else class="text-button" data-id="{{item.id}}" data-share="1" bindtap="useFile" disabled="{{busy}}">下载</button></view>
      </view>
      <button wx:if="{{own && selected.canEdit && files.length < 5}}" class="upload-button" bindtap="addFiles" disabled="{{busy || saveState === '自动保存失败'}}">＋ 上传文件</button>
      <view wx:if="{{own}}" class="submission-footer"><text wx:if="{{saveState}}" class="meta save-state">{{saveState}}</text><button wx:if="{{saveState === '自动保存失败'}}" class="secondary wide" bindtap="retrySave" disabled="{{busy}}">重试自动保存</button><view class="submission-actions"><button class="secondary" bindtap="previewSubmission" loading="{{previewing}}" disabled="{{busy || previewing}}">效果预览</button><button wx:if="{{selected.canEdit}}" class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || previewing || !files.length || saveState === '自动保存失败' || (report && report.status === 'submitted' && !report.hasChanges)}}">{{report && report.status === 'submitted' ? '重新提交' : '提交周报'}}</button></view></view>
    </view>
    <view wx:if="{{versions.length && (!isLeader || !own)}}" class="card">
      <text class="section-title">提交记录</text>
      <view wx:for="{{versions}}" wx:key="id" wx:for-item="version" class="version">
        <view class="heading"><text>第 {{version.version}} 次提交</text><text class="meta {{version.late ? 'danger' : ''}}">{{version.late ? '逾期提交' : '已提交'}}</text></view>
        <text class="meta">{{version.dateLabel}}</text>
        <block wx:if="{{selected.schema}}"><button class="text-button" data-id="{{version.id}}" bindtap="toggleVersion" disabled="{{busy}}">{{version.expanded ? '收起内容' : '查看内容'}}</button><weekly-fields wx:if="{{version.expanded}}" schema="{{selected.schema}}" answers="{{version.answers}}" selected-fields="{{version.selectedFields}}" files="{{version.files}}" image-urls="{{version.imageURLs}}" period-id="{{selected.id}}" version-id="{{version.id}}" readonly embedded bindfile="fieldFile" /></block>
        <block wx:else><view wx:for="{{version.files}}" wx:key="id" class="file-row"><text class="file-name">{{item.name}}</text><view class="file-actions"><button class="text-button" data-id="{{item.id}}" data-version="{{version.id}}" bindtap="useFile" disabled="{{busy}}">查看</button><button class="text-button" data-id="{{item.id}}" data-version="{{version.id}}" data-share="1" bindtap="useFile" disabled="{{busy}}">下载</button></view></view></block>
      </view>
    </view>
  </block>
  <block wx:elif="{{mode === 'team' && selected}}">
    <view class="card team-summary">
      <text class="section-title">{{selected.displayTitle || selected.title}}</text>
      <view class="field"><text>已提交 / 应提交</text><text>{{submitted}} / {{total}}</text></view>
      <view wx:if="{{(canRemind && selected.status === 'open') || canExport}}" class="team-management-actions"><button wx:if="{{canRemind && selected.status === 'open'}}" class="secondary" bindtap="remind" disabled="{{busy}}">催交</button><button wx:if="{{canExport}}" class="secondary" bindtap="exportStats" disabled="{{busy}}">导出统计</button></view>
    </view>
    <view class="filters"><button class="{{filter === 'all' ? 'active' : ''}}" data-value="all" bindtap="setFilter">全部</button><button class="{{filter === 'pending' ? 'active' : ''}}" data-value="pending" bindtap="setFilter">未提交</button><button class="{{filter === 'submitted' ? 'active' : ''}}" data-value="submitted" bindtap="setFilter">已提交</button><button class="{{filter === 'exempt' ? 'active' : ''}}" data-value="exempt" bindtap="setFilter">免交</button></view>
    <view class="team-list"><text wx:if="{{!filteredRows.length}}" class="card empty">暂无记录</text>
      <view wx:for="{{filteredRows}}" wx:key="id" class="card team-entry">
        <view class="team-row"><view class="file-info"><view class="team-member-name"><view class="member-symbol"><imc-icon name="user" tone="muted" size="{{17}}" /></view><text class="row-title">{{item.name}}</text></view><text wx:if="{{item.status === 'submitted'}}" class="meta">{{item.dateLabel}}</text><text wx:if="{{item.exemption}}" class="meta">{{item.exemption}}</text></view><text class="badge {{item.status === 'submitted' ? 'success' : ''}}">{{item.statusLabel}}</text></view>
        <button wx:if="{{selected.schema && item.status === 'submitted'}}" class="text-button team-read-button" data-id="{{item.id}}" bindtap="toggleTeamContent" disabled="{{busy}}">{{item.expanded ? '收起周报' : '查看周报'}}</button>
        <view wx:if="{{item.expanded && item.detail}}" class="team-content"><weekly-fields schema="{{selected.schema}}" answers="{{item.detail.report.answers}}" selected-fields="{{item.detail.report.selectedFields}}" files="{{item.detail.report.files}}" image-urls="{{item.detail.imageURLs}}" readonly embedded bindfile="fieldFile" /></view>
        <block wx:if="{{!selected.schema}}"><view wx:for="{{item.files}}" wx:for-item="file" wx:key="id" class="file-row"><text class="file-name">{{file.name}}</text><view class="file-actions"><button class="text-button" data-id="{{file.id}}" bindtap="useFile" disabled="{{busy}}">查看</button><button class="text-button" data-id="{{file.id}}" data-share="1" bindtap="useFile" disabled="{{busy}}">下载</button></view></view></block>
      </view>
    </view>
  </block>
  <block wx:elif="{{mode === 'form' && form}}">
    <view class="card">
      <view class="section-title icon-heading"><imc-icon name="calendar" tone="primary" size="{{16}}" background /><text>{{form.revision ? '周期信息' : '发布信息'}}</text></view>
      <view class="field"><text>表单模板</text><button class="text-button" bindtap="manageTemplates" disabled="{{busy}}">{{form.templateName || '选择模板'}} ›</button></view>
      <button class="text-button edit-period-form" bindtap="editPeriodForm" disabled="{{busy}}">编辑本期表单</button>
      <text class="label">周报名称</text><input class="input" value="{{form.title}}" data-field="title" bindinput="formInput" maxlength="60" disabled="{{busy}}" />
      <view wx:if="{{form.canSchedule}}" class="field"><text>定时发布</text><switch checked="{{form.scheduled}}" bindchange="scheduleInput" color="#2860cf" disabled="{{busy}}" /></view>
      <block wx:if="{{form.scheduled}}"><text class="label">发布时间（北京时间）</text><view class="date-time"><picker mode="date" value="{{form.publishDate}}" data-field="publishDate" bindchange="formInput" disabled="{{busy}}"><view class="picker-value">{{form.publishDate}} ›</view></picker><picker mode="time" value="{{form.publishTime}}" data-field="publishTime" bindchange="formInput" disabled="{{busy}}"><view class="picker-value">{{form.publishTime}} ›</view></picker></view></block>
      <view class="field"><text>开始日期</text><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="formInput" disabled="{{busy}}"><view class="picker-value">{{form.startDate}} ›</view></picker></view>
      <view class="field"><text>结束日期</text><picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="formInput" disabled="{{busy}}"><view class="picker-value">{{form.endDate}} ›</view></picker></view>
      <text class="label">提交截止时间</text><view class="date-time"><picker mode="date" value="{{form.deadlineDate}}" data-field="deadlineDate" bindchange="formInput" disabled="{{busy}}"><view class="picker-value">{{form.deadlineDate}} ›</view></picker><picker mode="time" value="{{form.deadlineTime}}" data-field="deadlineTime" bindchange="formInput" disabled="{{busy}}"><view class="picker-value">{{form.deadlineTime}} ›</view></picker></view>
      <view class="field"><text>允许逾期补交</text><switch checked="{{form.allowLateSubmit}}" data-field="allowLateSubmit" bindchange="formInput" color="#2860cf" disabled="{{busy}}" /></view>
      <view class="field"><text>允许逾期修改</text><switch checked="{{form.allowLateEdit}}" data-field="allowLateEdit" bindchange="formInput" color="#2860cf" disabled="{{busy}}" /></view>
      <view wx:if="{{form.revision && !form.canSchedule}}" class="field"><text>周期状态</text><picker range="{{['开放中', '已关闭', '已归档']}}" value="{{form.statusIndex}}" bindchange="statusInput" disabled="{{busy}}"><view class="picker-value">{{form.statusIndex === 0 ? '开放中' : form.statusIndex === 1 ? '已关闭' : '已归档'}} ›</view></picker></view>
    </view>
    <view class="card"><view class="section-title icon-heading"><imc-icon name="users" tone="primary" size="{{16}}" background /><text>应交成员</text></view><input class="input member-search" value="{{memberQuery}}" bindinput="searchMembers" placeholder="搜索成员" />
      <view wx:for="{{shownMembers}}" wx:key="id" class="member-item"><button class="member-select" data-id="{{item.id}}" bindtap="toggleMember" disabled="{{busy}}"><text class="check {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</text><text>{{item.name}}</text></button><input wx:if="{{item.selected}}" class="input exemption" value="{{item.exempt}}" data-id="{{item.id}}" bindinput="exemptionInput" maxlength="80" placeholder="免交原因（选填）" disabled="{{busy}}" /></view>
    </view>
    <view class="period-form-footer"><button class="primary wide" bindtap="savePeriod" disabled="{{busy}}" loading="{{busy}}">{{form.scheduled ? '保存定时发布' : form.revision ? '更新周期' : '发布周报'}}</button></view>
    <button wx:if="{{form.revision && form.status === 'scheduled'}}" class="secondary wide danger" bindtap="cancelScheduled" disabled="{{busy}}">取消定时发布</button>
  </block>
  <view wx:if="{{actionError}}" class="error action-error">{{actionError}}</view>
  </block>
</view>
