@import "../../styles/controls.wxss";
:host { display: block; }
.weekly { color: #101b2b; font-size: 16px; line-height: 1.6; padding-bottom: env(safe-area-inset-bottom); }
button { box-sizing: border-box; font: inherit; line-height: 26px; border-radius: 8px; margin: 0; background: #fff; color: #101b2b; }
button::after { border: 0; }
button[disabled] { opacity: .5; }
.toolbar, .heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.toolbar { margin-bottom: 14px; min-height: 44px; }
.section-title { display: block; font-size: 20px; font-weight: 600; line-height: 30px; overflow-wrap: anywhere; }
.card { box-sizing: border-box; padding: 18px; margin-bottom: 16px; border: 1px solid #e5eaf2; border-radius: 10px; background: #fff; }
.preview-document { padding: 4px 0 16px; background: #fff; }
.preview-name { display: block; text-align: center; color: #101b2b; font-size: 20px; font-weight: 600; line-height: 30px; margin: 12px 0 24px; overflow-wrap: anywhere; }
.period-row { width: 100%; text-align: left; }
.row-title { font-size: 16px; font-weight: 500; overflow-wrap: anywhere; }
.meta { display: block; color: #526173; font-size: 13px; line-height: 22px; overflow-wrap: anywhere; }
.period-row > .meta { margin: 8px 0 4px; }
.badge { flex-shrink: 0; color: #526173; font-size: 13px; line-height: 24px; padding: 0 7px; background: #f4f6f9; border-radius: 4px; }
.success { color: #087f58; background: #edf7f2; }
.field { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px solid #e5eaf2; min-height: 56px; padding: 8px 0; box-sizing: border-box; }
.field > text:first-child { color: #526173; flex-shrink: 0; }
.field > text:last-child { text-align: right; overflow-wrap: anywhere; }
.field:last-child { border-bottom: 0; }
.field > .text-button { flex: 1; min-width: 0; white-space: normal; overflow-wrap: anywhere; text-align: right; }
.field > picker { min-width: 0; }
.card > .meta { margin-top: 8px; }
.actions { display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap; }
.center-actions { justify-content: center; }
.toolbar-actions { display: flex; gap: 20px; flex-wrap: wrap; }
.team-entry .team-row { border-bottom: 0; padding: 0; }
.primary, .secondary, .upload-button { min-height: 44px; padding: 9px 16px; }
.primary { background: #2860cf; color: #fff; }
.secondary { background: #edf2ff; color: #2860cf; }
.wide { width: 100%; margin-top: 14px; }
.text-button { min-height: 44px; min-width: 44px; padding: 9px 4px; color: #2860cf; flex-shrink: 0; font-size: 14px; }
.file-row { padding: 12px 0; border-bottom: 1px solid #e5eaf2; }
.file-row:last-child { border-bottom: 0; }
.file-info { flex: 1; min-width: 0; }
.file-name { display: block; overflow-wrap: anywhere; word-break: break-all; font-size: 16px; }
.file-actions { display: flex; gap: 12px; justify-content: flex-end; flex-wrap: wrap; }
.file-actions .text-button { padding-left: 8px; padding-right: 8px; }
.upload-button { width: 100%; border: 1px dashed #a7b5c5; margin-top: 16px; color: #2860cf; }
.version { padding-top: 16px; margin-top: 16px; border-top: 1px solid #e5eaf2; }
.filters { display: flex; background: #f4f6f9; padding: 4px; border-radius: 8px; margin: 16px 0; }
.filters button { flex: 1; min-width: 0; padding: 9px 2px; min-height: 44px; background: transparent; color: #526173; font-size: 14px; white-space: nowrap; }
.filters .active { color: #2860cf; background: #edf2ff; font-weight: 600; }
.team-list { padding-top: 0; padding-bottom: 0; }
.team-row { display: flex; width: 100%; align-items: center; gap: 10px; padding: 16px 0; text-align: left; border-bottom: 1px solid #e5eaf2; border-radius: 0; min-height: 64px; }
.team-row:last-child { border-bottom: 0; }
.arrow { color: #6b788a; }
.label { display: block; color: #526173; margin: 16px 0 8px; }
.input { box-sizing: border-box; height: 48px; width: 100%; padding: 0 12px; border: 1px solid #e5eaf2; border-radius: 8px; color: #101b2b; font-size: 16px; background: #fff; }
.picker-value { min-height: 44px; display: flex; align-items: center; justify-content: flex-end; color: #2860cf; }
.date-time { display: flex; justify-content: space-between; gap: 12px; }
.date-time picker:first-child { flex: 1; }
.date-time .picker-value { justify-content: flex-start; }
.member-search { margin-top: 16px; }
.member-item { border-bottom: 1px solid #e5eaf2; padding: 8px 0 16px; }
.member-item:last-child { border-bottom: 0; padding-bottom: 0; }
.member-select { display: flex; align-items: center; gap: 12px; text-align: left; min-height: 48px; padding: 8px 0; width: 100%; }
.check { box-sizing: border-box; border: 1px solid #a7b5c5; border-radius: 4px; width: 22px; height: 22px; line-height: 20px; text-align: center; flex-shrink: 0; }
.checked { color: white; background: #2860cf; border-color: #2860cf; }
.exemption { font-size: 14px; }
.error { padding: 16px; border: 1px solid #ecd4d0; border-radius: 10px; color: #ad4037; background: #fffaf9; overflow-wrap: anywhere; }
.error .secondary { margin-top: 12px; }
.empty { display: block; color: #526173; text-align: center; padding: 24px 12px; }
.action-error { margin-top: 16px; }
.danger { color: #ad4037; }
.period-card .period-row { padding: 0; margin: 0; border: 0; border-radius: 0; background: #fff; }
.list-toolbar { margin-bottom: 8px; }
.page-title { font-size: 24px; line-height: 34px; }
.list-management { margin-bottom: 16px; }
.list-management .text-button { padding-left: 0; padding-right: 0; }
.period-group { margin-bottom: 8px; }
.group-label { display: block; margin: 26px 0 12px; font-size: 14px; color: #6b788a; }
.period-topline { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 26px; }
.period-status { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.more-button { width: 44px; min-height: 44px; padding: 0; color: #6b788a; font-size: 16px; letter-spacing: 2px; }
.period-title { display: block; color: #101b2b; font-size: 20px; line-height: 29px; font-weight: 600; overflow-wrap: anywhere; }
.period-card .period-row { min-height: 44px; display: flex; align-items: center; }
.period-deadline { margin-top: 4px; }
.accent-badge { color: #2860cf; background: #edf2ff; }
.period-entry-actions { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 8px; }
.period-entry-actions .text-button { padding-left: 0; padding-right: 0; }
.prominent-actions { flex-wrap: nowrap; gap: 12px; margin-top: 18px; }
.prominent-actions > button { flex: 1; min-width: 0; padding: 9px 8px; white-space: nowrap; }
.detail-heading { align-items: flex-start; }
.detail-heading .section-title { flex: 1; min-width: 0; }
.detail-heading .badge { margin-top: 3px; }
.detail-team-action { display: flex; justify-content: center; margin-top: 18px; }
.detail-team-action button { width: 100%; min-height: 44px; }
.management-actions { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 12px; border-top: 1px solid #e5eaf2; padding-top: 8px; }
.management-actions > button { flex: 1; }
.submission-footer { margin: 24px 0; padding-top: 16px; border-top: 1px solid #e5eaf2; }
.submission-actions { display: flex; gap: 12px; margin-top: 14px; }
.submission-actions > button { flex: 1; min-width: 0; padding: 9px 8px; white-space: nowrap; }
.save-state { font-size: 13px; }
.team-management-actions { display: flex; gap: 12px; margin-top: 16px; }
.team-management-actions > button { flex: 1; min-width: 0; }
.team-read-button { display: inline-block; padding-left: 0; margin-top: 4px; text-align: left; }
.team-entry .row-title { font-weight: 600; }
.team-content { margin-top: 12px; padding-top: 4px; border-top: 1px solid #e5eaf2; }
.change-status { color: #2860cf; }
@media (max-width: 350px) { .card { padding-left: 12px; padding-right: 12px; } .heading { gap: 8px; } .section-title { font-size: 20px; } .field { align-items: flex-start; } .badge { padding: 0 5px; } }

.weekly { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.card { border-color: #e9edf5; border-radius: 14px; margin-bottom: 14px; }
.primary, .secondary { border-radius: 10px; min-height: 46px; padding: 11px 13px; line-height: 24px; }
.primary { background: #2860cf; }
.meta { color: #6b788a; font-size: 13px; }
.badge { border-radius: 6px; font-size: 11px; line-height: 24px; padding: 0 7px; }
.success { background: #eaf7f0; color: #087f58; }
.period-title { font-size: 21px; line-height: 31px; }
.current-period { border-top: 3px solid #2860cf; padding-top: 16px; }
.current-period .period-title { font-size: 22px; }
.period-topline { align-items: center; }
.group-label { font-size: 13px; font-weight: 500; margin: 24px 0 10px; }
.section-title { font-size: 19px; line-height: 29px; }
.page-title { font-size: 24px; line-height: 34px; }
.list-management { gap: 12px; margin-top: -2px; }
.list-management .text-button { border: 1px solid #e5eaf2; padding: 3px 10px; min-height: 36px; line-height: 26px; background: #fff; border-radius: 7px; font-size: 13px; }
.field { border-color: #edf0f4; min-height: 57px; font-size: 15px; padding: 10px 0; }
.field > text:first-child { font-size: 14px; color: #6b788a; }
.label { margin-top: 18px; margin-bottom: 8px; font-size: 14px; line-height: 22px; }
.input { height: 48px; border-radius: 9px; border-color: #e4e8ef; background: #fafbfd; }
.date-time { gap: 10px; }
.date-time picker { flex: 1; min-width: 0; }
.date-time .picker-value { min-height: 47px; box-sizing: border-box; padding: 10px 12px; border: 1px solid #e4e8ef; background: #fafbfd; border-radius: 9px; font-size: 15px; line-height: 25px; }
.edit-period-form { padding-left: 0; min-height: 44px; text-align: left; font-size: 13px; }
.filters { background: #e9edf4; border-radius: 10px; padding: 4px; margin: 0 0 17px; }
.filters button { font-size: 14px; border-radius: 7px; color: #687688; }
.filters .active { background: #fff; color: #2860cf; }
.team-entry { padding-top: 17px; padding-bottom: 13px; }
.team-member-name { display: flex; align-items: center; gap: 9px; }
.member-symbol { width: 31px; height: 31px; background: #edf2fa; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.team-entry .file-info > .meta { padding-left: 40px; margin-top: 3px; }
.team-row { min-height: 0; border-color: #edf0f4; }
.team-content { margin-top: 11px; padding-top: 14px; border-color: #e6ebf2; }
.file-row { border-color: #edf0f4; }
.upload-button { border-radius: 10px; }
.has-submission-footer { padding-bottom: calc(115px + env(safe-area-inset-bottom)); }
.submission-footer { position: fixed; z-index: 15; left: 0; right: 0; bottom: 0; box-sizing: border-box; margin: 0; padding: 10px 16px calc(11px + env(safe-area-inset-bottom)); border-top: 1px solid #e5eaf1; background: #fff; }
.submission-actions { margin-top: 9px; gap: 12px; }
.save-state { font-size: 12px; line-height: 18px; }
.has-form-footer { padding-bottom: calc(85px + env(safe-area-inset-bottom)); }
.period-form-footer { position: fixed; z-index: 15; left: 0; right: 0; bottom: 0; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); border-top: 1px solid #e5eaf1; background: #fff; }
.period-form-footer .wide { margin: 0; }
.preview-document { padding-top: 7px; }
.preview-name { font-size: 22px; line-height: 33px; margin: 15px 0 30px; }

.personal-edit-summary { border: 0; background: transparent; padding: 0; margin-bottom: 18px; }
.personal-edit-summary .section-title { font-size: 20px; line-height: 30px; }
