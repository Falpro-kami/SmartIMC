.preview-section { margin-bottom: 18px; }
.preview-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; color: #101b2b; font-size: 19px; font-weight: 600; }
.preview-counter { color: #8a98ad; font-size: 12px; font-weight: 400; letter-spacing: 2px; }
.preview-swiper { height: 206px; border-radius: 14px; overflow: hidden; }
.preview-card { position: relative; display: block; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; border-radius: 14px; overflow: hidden; background: #203c75; color: #fff; text-align: left; }
.preview-card::after { border: 0; }
.preview-image, .preview-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.preview-shade { background: linear-gradient(180deg, rgba(9, 23, 54, .05) 20%, rgba(9, 23, 54, .80) 100%); }
.preview-top { position: absolute; top: 16px; right: 18px; left: 18px; display: flex; align-items: center; justify-content: space-between; }
.preview-category { padding: 3px 9px; border: 1px solid rgba(255, 255, 255, .25); border-radius: 5px; background: rgba(255, 255, 255, .13); font-size: 11px; line-height: 20px; }
.preview-placeholder { color: rgba(255, 255, 255, .75); font-size: 10px; }
.preview-copy { position: absolute; right: 18px; bottom: 17px; left: 18px; }
.preview-title { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 22px; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.preview-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 7px; }
.preview-subtitle { flex: 1; color: rgba(255, 255, 255, .75); font-size: 11px; line-height: 21px; }
.preview-arrow { flex-shrink: 0; color: #fff; font-size: 23px; line-height: 26px; }
.preview-dots { display: flex; justify-content: center; gap: 5px; margin-top: 11px; }
.preview-dot { width: 4px; height: 4px; border-radius: 3px; background: #c7d3e7; }
.preview-dot.active { width: 16px; background: #2860cf; }
.preview-error { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 6px; color: #8a98ad; font-size: 11px; }
.preview-error button { margin: 0; padding: 6px 0; background: transparent; color: #2860cf; font-size: 11px; line-height: 22px; }
@media (max-width: 350px) { .preview-swiper { height: 190px; } .preview-title { font-size: 20px; } }
